rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Dashboard Visits Collection Rules
    match /dashboard_visits/{visitId} {
      // Allow creation of logs with rigorous schema and boundary checking
      allow create: if (
        request.resource.data.keys().hasAll(['path', 'timestamp']) &&
        request.resource.data.keys().size() == 2 &&
        request.resource.data.path is string &&
        request.resource.data.path.size() <= 2048 &&
        request.resource.data.timestamp is timestamp
      );

      // Allow reading or count retrieval of visits
      allow read: if true;
    }
  }
}
